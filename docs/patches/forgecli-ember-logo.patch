+/// `s` in at most `max` columns, its end kept: `…/live/proj`.
+fn keep_end(s: &str, max: usize) -> String {
+    if width(s) <= max {
+        return s.to_string();
+    }
+    let mut tail: Vec<char> = vec![];
+    let mut w = 1;
+    for c in s.chars().rev() {
+        let cw = width(&c.to_string());
+        if w + cw > max {
+            break;
+        }
+        w += cw;
+        tail.push(c);
+    }
+    tail.reverse();
+    format!("…{}", tail.into_iter().collect::<String>())
+}
